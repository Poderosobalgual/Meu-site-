# Copie este arquivo para .env.local e preencha. NUNCA suba o .env.local para o GitHub.

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://navalhadeouro.com.br

# Resend: envio dos agendamentos por e-mail (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remetente: precisa ser de um domínio verificado no Resend
EMAIL_FROM="Site Navalha d'Ouro <site@navalhadeouro.com.br>"
# Para onde os agendamentos são enviados
EMAIL_TO=contato@navalhadeouro.com.br

# Cloudflare Turnstile (captcha) - https://dash.cloudflare.com > Turnstile
# Chaves de TESTE abaixo sempre aprovam; troque pelas reais em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Analytics 4 (opcional) - só carrega depois do aceite de cookies
NEXT_PUBLIC_GA_ID=

# Sentry (opcional) - captura de erros
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
